rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(roomId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(roomId)).data.members;
    }

    match /users/{userId}/account/data {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /couples/{roomId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid];
      allow update: if (
          isMember(roomId)
          && request.resource.data.members == resource.data.members
        ) || (
          signedIn()
          && !(request.auth.uid in resource.data.members)
          && resource.data.members.size() == 1
          && request.resource.data.members.size() == 2
          && request.auth.uid in request.resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        );
      allow delete: if false;

      match /events/{eventId} {
        allow read, write: if isMember(roomId);
      }
    }
  }
}
